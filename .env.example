# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Límites y reintentos
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=60000
DB_LOCK_TIMEOUT_MS=10000
DB_CONNECT_ATTEMPTS=3
DB_RETRY_BASE_DELAY=1

# Opcionales. Si se omiten, se usan logs/app.log y el directorio temporal.
# APP_LOG_FILE=/ruta/al/app.log
# APP_LOCK_FILE=/ruta/al/app.lock
